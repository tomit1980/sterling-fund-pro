# ---- Core ----
NODE_ENV=development
# Local dev: `npm run db:start` launches an embedded PostgreSQL on this URL.
DATABASE_URL=postgresql://sfp:sfp@127.0.0.1:5433/sterling_fund_pro
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 32-byte base64 key used to encrypt MFA secrets at rest. Generate: `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
APP_ENCRYPTION_KEY=
# Random secret used to derive session cookie HMACs / CSRF tokens.
APP_SECRET=

# ---- Email ----
# When unset, outgoing email is captured in the OutboundEmail table and shown at /dev/mailbox (development only).
# Example: smtp://user:pass@smtp.example.com:587
SMTP_URL=
EMAIL_FROM="Sterling Fund Pro <no-reply@example.com>"
# Where contact-form notifications are sent (optional).
SUPPORT_NOTIFY_EMAIL=

# ---- Market data ----
# demo (default) | finnhub
MARKET_DATA_PROVIDER=demo
FINNHUB_API_KEY=

# ---- Public business details (leave empty until verified) ----
NEXT_PUBLIC_CONTACT_EMAIL=support@example.com
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_ADDRESS=
NEXT_PUBLIC_LEGAL_ENTITY=
NEXT_PUBLIC_LEGAL_REGISTRATION=
NEXT_PUBLIC_REGULATOR_NAME=
NEXT_PUBLIC_LICENCE_NUMBER=
NEXT_PUBLIC_JURISDICTION=

# ---- Seed admin (used by `npm run db:seed`; change immediately in any shared environment) ----
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe-Admin-2026!
SEED_DEMO_USER_EMAIL=demo@example.com
SEED_DEMO_USER_PASSWORD=ChangeMe-Demo-2026!
